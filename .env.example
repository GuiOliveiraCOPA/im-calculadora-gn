# Copie para .env e preencha. O .env NUNCA vai para o repositório nem para a imagem.
# Os valores abaixo são fictícios; informe os reais só no seu .env.

# --- Ambiente: dev | hml | prd -------------------------------------------------
# dev -> marketing_dev.dbt_guilherme_oliveira
# hml -> marketing_hml.marketing_gold
# prd -> marketing_prd.marketing_gold
GN_AMBIENTE=dev

# Override explícito (opcional)
# GN_CATALOGO=
# GN_SCHEMA=
# GN_TABELA_TARIFAS=fct_gn_tarifa_vigente_calculadora
# GN_TABELA_PARAMETROS=fct_gn_parametro_vigente_calculadora

# --- Fonte: databricks (padrão) | json (offline/testes) -----------------------------
GN_FONTE=databricks
# Somente com GN_FONTE=json:
# GN_ARQUIVO_JSON=tests/fixtures/tarifas_2026-09-03.json

# --- Databricks (SQL Warehouse) -----------------------------------------------------
DATABRICKS_HOST=adb-0000000000000000.0.azuredatabricks.net
DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/0000000000000000

# --- Autenticação: pat (dev) | oauth_m2m (hml/prd) | oauth_u2m (dev local) ----------
# Padrão: pat em dev, oauth_m2m em hml/prd.
GN_AUTH_TIPO=pat
# Somente pat:
DATABRICKS_TOKEN=
# Somente oauth_m2m (service principal):
# DATABRICKS_CLIENT_ID=
# DATABRICKS_CLIENT_SECRET=
# Somente oauth_u2m (login local: databricks auth login --host https://<host>):
# DATABRICKS_CONFIG_PROFILE=env_marketing

# --- Carga e cache ------------------------------------------------------------------
GN_RECARGA_MINUTOS=30
GN_TIMEOUT_CONSULTA_S=60
GN_CACHE_PATH=./.cache/tarifas.json
GN_BASE_MAX_IDADE_HORAS=72

# --- Servidor -----------------------------------------------------------------------
# HOST=127.0.0.1
# PORTA=5000
# FLASK_DEBUG=0
# TZ=America/Sao_Paulo
# Proxy corporativo, se houver (respeitado pela biblioteca de HTTP):
# HTTPS_PROXY=
# NO_PROXY=
